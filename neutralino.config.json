{
  "applicationId": "com.github.vantoan1511.table-view",
  "applicationName": "Table View",
  "author": "Toan Nguyen",
  "version": "0.0.1",
  "defaultMode": "window",
  "documentRoot": "/build/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "singlePageServe": true,
  "enableExtensions": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "storage.*",
    "extensions.*",
    "events.*",
    "window.*"
  ],
  "extensions": [
    {
      "id": "com.github.vantoan1511.table-view.db-bridge",
      "command": "${NL_PATH}\\extensions\\db-bridge\\db-bridge.exe"
    }
  ],
  "modes": {
    "window": {
      "title": "Table View",
      "width": 1280,
      "height": 720,
      "minWidth": 640,
      "minHeight": 480,
      "center": true,
      "icon": "/public/favicon.ico",
      "enableInspector": false,
      "openInspectorOnStartup": false
    }
  },
  "cli": {
    "binaryName": "table-view",
    "resourcesPath": "/build/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "devUrl": "http://localhost:5173",
      "projectPath": "/",
      "initCommand": "npm install",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build"
    }
  }
}