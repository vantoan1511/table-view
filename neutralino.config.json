{
  "applicationId": "com.github.vantoan1511.tableview",
  "applicationName": "Table View",
  "author": "Toan Nguyen",
  "applicationIcon": "public/icon.png",
  "description": "Lightweight, high-performance desktop database management tool for PostgreSQL, MySQL, SQLite, and Oracle.",
  "version": "0.6.6",
  "copyright": "Copyright © Table View 2026. All rights reserved.",
  "documentRoot": "/build/",
  "defaultMode": "window",
  "storageLocation": "system",
  "dataLocation": "system",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "port": 0,
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "singlePageServe": true,
  "enableExtensions": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "storage.*",
    "extensions.*",
    "events.*",
    "window.*",
    "updater.*",
    "app.restartProcess"
  ],
  "extensions": [
    {
      "id": "com.github.vantoan1511.tableview.db-bridge",
      "command": "bin\\db-bridge.exe"
    }
  ],
  "modes": {
    "window": {
      "title": "Table View",
      "width": 1280,
      "height": 800,
      "minWidth": 1024,
      "minHeight": 720,
      "center": true,
      "icon": "/public/icon.png",
      "enableInspector": false
    }
  },
  "cli": {
    "binaryName": "table-view",
    "resourcesPath": "/build/",
    "resourcesExclude": ".*\\.ts$|.*\\.tsx$|.*\\.map$",
    "extensionsPath": "/bin/",
    "extensionsExclude": "",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "devUrl": "http://localhost:5173",
      "projectPath": "/",
      "initCommand": "npm install",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build && node scripts/build-ext.js"
    }
  }
}