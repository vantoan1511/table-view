{
  "applicationId": "com.github.vantoan1511.table-view",
  "applicationName": "Table View",
  "author": "Toan Nguyen",
  "version": "0.0.1",
  "defaultMode": "window",
  "documentRoot": "/src/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "singlePageServe": true,
  "tokenSecurity": "none",
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "storage.*"
  ],
  "modes": {
    "window": {
      "title": "Table View",
      "width": 800,
      "height": 500,
      "minWidth": 400,
      "minHeight": 200,
      "center": true,
      "icon": "/src/public/favicon.ico",
      "enableInspector": true,
      "openInspectorOnStartup": false
    }
  },
  "cli": {
    "binaryName": "my-neu-zero",
    "resourcesPath": "/src/dist/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0",
    "frontendLibrary": {
      "patchFile": "/src/index.html",
      "devUrl": "http://localhost:5173",
      "projectPath": "/src",
      "initCommand": "npm install",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build"
    }
  }
}