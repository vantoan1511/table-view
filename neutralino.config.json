{
  "applicationId": "com.github.vantoan1511.table-view",
  "version": "0.1.2",
  "defaultWidth": 1280,
  "defaultHeight": 800,
  "minWidth": 800,
  "minHeight": 600,
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableInspector": false,
  "enableLog": true,
  "tokenSecurity": "one-time",
  "enableExtensions": true,
  "nativeAllowList": [
    "app.*",
    "os.*",
    "debug.log",
    "filesystem.*",
    "window.*",
    "storage.*",
    "extensions.*",
    "updater.*"
  ],
  "modes": {
    "window": {
      "title": "Table View",
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 600,
      "icon": "/icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "alwaysOnTop": false,
      "fullScreen": false,
      "center": true,
      "disableResize": false
    }
  },
  "cli": {
    "binaryName": "table-view",
    "resourcesPath": "/build",
    "extensionsPath": "/extensions",
    "clientLibrary": "/public/__neutralino_globals.js",
    "binaryVersion": "5.5.0",
    "clientVersion": "5.5.0"
  },
  "extensions": [
    {
      "id": "com.github.vantoan1511.table-view.db-bridge",
      "command": "extensions\\db-bridge\\db-bridge.exe"
    }
  ]
}
