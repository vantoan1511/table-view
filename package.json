{
  "name": "src",
  "version": "0.6.8",
  "description": "Lightweight, high-performance desktop database management tool for PostgreSQL, MySQL, SQLite, and Oracle.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "neu:run": "neu run",
    "neu:update": "neu update",
    "neu:build": "neu build && node scripts/clean-dist.js",
    "build": "run-p type-check \"build-only {@}\" --",
    "package": "node scripts/build-installer.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
